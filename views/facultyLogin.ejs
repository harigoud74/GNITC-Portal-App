<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Faculty Login - GNITC Portal</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      body {
        background-color: #f3f4f6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      .admin-card {
        border-top: 5px solid #4f46e5;
      }
    </style>
  </head>
  <body>
    <nav class="navbar navbar-light bg-white shadow-sm">
      <div class="container">
        <a class="navbar-brand fw-bold text-dark" href="/student-login">
          <i class="bi bi-layers-fill text-primary me-2"></i>GNITC
        </a>
        <a href="/student-login" class="btn btn-outline-secondary btn-sm"
          >Student Portal</a
        >
      </div>
    </nav>

    <div
      class="container flex-grow-1 d-flex align-items-center justify-content-center">
      <div
        class="card border-0 shadow-lg rounded-4 admin-card p-4 p-md-5"
        style="width: 100%; max-width: 450px">
        <div class="text-center mb-4">
          <div
            class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
            style="width: 64px; height: 64px; font-size: 2rem">
            <i class="bi bi-shield-lock-fill"></i>
          </div>
          <h3 class="fw-bold text-dark">Faculty Access</h3>
          <p class="text-muted">Enter your staff credentials.</p>
        </div>

        <form action="/faculty-login" method="POST">
          <div class="mb-3">
            <label
              class="form-label fw-bold text-secondary small text-uppercase"
              >Staff Email ID</label
            >
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0"
                ><i class="bi bi-person text-muted"></i
              ></span>
              <input
                type="email"
                class="form-control border-start-0 bg-light py-2"
                name="email"
                placeholder="faculty@gnitc.edu"
                required />
            </div>
          </div>

          <div class="mb-4">
            <label
              class="form-label fw-bold text-secondary small text-uppercase"
              >Password</label
            >
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0"
                ><i class="bi bi-key text-muted"></i
              ></span>
              <input
                type="password"
                class="form-control border-start-0 bg-light py-2"
                name="password"
                placeholder="••••••••"
                required />
            </div>
          </div>

          <button
            type="submit"
            class="btn btn-primary w-100 py-2 fw-bold text-uppercase"
            style="background-color: #4f46e5; border-color: #4f46e5">
            Secure Login
          </button>
        </form>
      </div>
    </div>
  </body>
</html>
