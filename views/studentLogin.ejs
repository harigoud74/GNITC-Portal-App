<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Student Login</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
      body {
        background-color: #121212; 
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      }

      .login-container {
        background-color: #000000;
        color: #ffffff;
        max-width: 450px;
        padding: 3rem 2.5rem; /* Slightly more vertical padding for breathing room */
        border-radius: 12px; /* Softer, modern corners */
        border: 1px solid #2a2a2a; /* Subtle border to separate from background */
        position: relative;
      }

      .close-btn {
        position: absolute;
        top: 15px;
        right: 20px;
        color: #666;
        font-size: 1.5rem;
        cursor: pointer;
        text-decoration: none;
        transition: color 0.3s ease;
      }

      .close-btn:hover {
        color: #ffffff;
      }

      .form-label {
        font-weight: 500;
        font-size: 1rem;
        color: #e0e0e0;
        margin-bottom: 0.5rem;
      }

      .form-control-custom {
        background-color: #1e1e1e !important;
        border: 1px solid #333 !important;
        color: #ffffff !important;
        padding: 0.8rem 1rem;
        border-radius: 8px;
        transition: all 0.3s ease;
      }

      .form-control-custom::placeholder {
        color: #666666;
      }

      .form-control-custom:focus {
        background-color: #252525 !important;
        border-color: #6474db !important;
        box-shadow: 0 0 0 4px rgba(100, 116, 219, 0.15) !important;
      }

      .btn-custom-purple {
        background-color: #6474db;
        border: none;
        color: white;
        font-weight: 600;
        padding: 0.8rem;
        font-size: 1.1rem;
        border-radius: 8px;
        transition: all 0.3s ease;
      }

      .btn-custom-purple:hover {
        background-color: #5362c5;
        transform: translateY(-1px); /* Slight lift effect on hover */
        box-shadow: 0 4px 12px rgba(100, 116, 219, 0.3);
      }

      .footer-link {
        color: #6474db;
        text-decoration: none;
        font-size: 0.9rem;
        transition: color 0.3s ease;
      }

      .footer-link:hover {
        text-decoration: underline;
        color: #8391f2;
      }
    </style>
  </head>
  <body>
    <div class="container d-flex justify-content-center align-items-center min-vh-100">
      
      <div class="login-container w-100 shadow-lg">
        <a href="/" class="close-btn" aria-label="Close">&times;</a>

        <h2 class="text-center fw-bold mb-4 text-uppercase" style="letter-spacing: 1px; font-size: 1.5rem">
          Student Login
        </h2>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger py-2 px-3 text-center rounded-3 mb-4" role="alert">
            <small><i class="bi bi-exclamation-circle me-1"></i> <%= error %></small>
          </div>
        <% } %>

        <form method="POST" action="/student-login">
          
          <div class="mb-4">
            <label for="rollno" class="form-label">Roll Number</label>
            <input
              type="text"
              id="rollno"
              name="rollNo"
              class="form-control form-control-custom"
              placeholder="e.g. 24CS001"
              autocomplete="username"
              required 
            />
          </div>

          <div class="mb-4">
            <label for="password" class="form-label">Password</label>
            <input
              type="password"
              id="password"
              name="password"
              class="form-control form-control-custom"
              placeholder="Enter your password"
              autocomplete="current-password"
              required 
            />
          </div>

          <div class="d-grid gap-2 mb-4 mt-2">
            <button type="submit" class="btn btn-custom-purple">
              Login
            </button>
          </div>

          <div class="d-flex justify-content-between pt-2">
            <a href="/student-register" class="footer-link">Create Account</a>
            <a href="#" class="footer-link">Forgot password?</a>
          </div>

        </form>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>