<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GNITC Student | Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    
    <style>
        :root {
            --gnitc-brand: #6474DB;
            --gnitc-brand-hover: #5363c5;
        }

        body {
            /* A fresh, airy, light gradient background */
            background: linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
        }
        
        .glass-card {
            width: 100%;
            max-width: 400px;
            /* Light Liquid Glass Effect */
            background: rgba(255, 255, 255, 0.45); /* Frosty white */
            backdrop-filter: blur(16px); /* The blur effect */
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.6); /* Crisp white edge */
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.1); /* Very soft shadow */
            
            border-radius: 16px;
        }

        /* Make inputs match the light glass theme */
        .glass-input {
            background: rgba(255, 255, 255, 0.6) !important;
            border: 1px solid rgba(255, 255, 255, 0.8) !important;
            color: #212529 !important;
            transition: all 0.3s;
        }
        .glass-input::placeholder {
            color: rgba(33, 37, 41, 0.5) !important;
        }
        .glass-input:focus {
            background: rgba(255, 255, 255, 0.9) !important;
            border-color: var(--gnitc-brand) !important;
            box-shadow: 0 0 0 0.25rem rgba(100, 116, 219, 0.25) !important;
        }

        /* Brand styling for the button */
        .btn-primary { 
            background-color: var(--gnitc-brand); 
            border-color: var(--gnitc-brand); 
        }
        .btn-primary:hover { 
            background-color: var(--gnitc-brand-hover); 
            border-color: var(--gnitc-brand-hover); 
        }
        .text-brand { color: var(--gnitc-brand); }
    </style>
</head>
<body>

<div class="card border-0 glass-card p-4 p-md-5">
    <div class="text-center mb-4">
        <i class="bi bi-mortarboard-fill fs-1 text-brand"></i>
        <h4 class="mt-2 fw-bold text-dark">Student Portal</h4>
        <p class="small text-muted">Welcome back to GNITC</p>
    </div>

    <!-- Error Message Display -->
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger bg-danger bg-opacity-10 text-danger border-danger border-opacity-25 py-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
        </div>
    <% } %>

    <form action="/student-login" method="POST">
        <div class="mb-3">
            <label class="form-label fw-bold small text-uppercase text-muted">Roll Number</label>
            <input type="text" name="rollNo" class="form-control glass-input text-uppercase" required placeholder="e.g. 21XQ1A0501">
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold small text-uppercase text-muted">Password</label>
            <input type="password" name="password" class="form-control glass-input" required placeholder="••••••••">
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">Sign In</button>
    </form>
    
    <div class="text-center mt-4">
        <small class="text-muted">Don't have an account? <a href="/student-register" class="text-brand fw-bold text-decoration-none border-bottom border-primary">Register here</a></small>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>