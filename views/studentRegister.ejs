<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register Modal - Compact</title>
    <!-- Bootstrap 5 CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet" />

    <style>
      body {
        background-color: #121212;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      }

      /* Reduced max-width and vertical padding */
      .register-container {
        background-color: #000000;
        color: #ffffff;
        max-width: 380px;
        /* Reduced from 450px */
        padding: 1.75rem 2rem;
        /* Reduced padding */
        border-radius: 4px;
        position: relative;
      }

      .close-btn {
        position: absolute;
        top: 10px;
        right: 15px;
        color: #666;
        font-size: 1.25rem;
        cursor: pointer;
        text-decoration: none;
      }

      /* Smaller label sizes and margins */
      .form-label {
        font-weight: 600;
        font-size: 0.95rem;
        /* Reduced from 1.15rem */
        margin-bottom: 0.25rem;
      }

      /* Shorter input padding */
      .form-control-custom {
        background-color: #212121 !important;
        border: none !important;
        color: #ffffff !important;
        padding: 0.5rem 0.75rem;
        /* Reduced height */
        font-size: 0.9rem;
      }

      .form-control-custom::placeholder {
        color: #555555;
      }

      .form-control-custom:focus {
        background-color: #2a2a2a !important;
        box-shadow: 0 0 0 0.2rem rgba(100, 116, 219, 0.25);
      }

      /* Slimmed down button */
      .btn-custom-purple {
        background-color: #6474db;
        border: none;
        color: white;
        font-weight: 600;
        padding: 0.55rem;
        /* Reduced height */
        font-size: 0.95rem;
      }

      .btn-custom-purple:hover {
        background-color: #5362c5;
        color: white;
      }

      .footer-link {
        color: #6474db;
        text-decoration: none;
        font-size: 0.85rem;
      }

      .footer-link:hover {
        text-decoration: underline;
      }

      .footer-text {
        font-size: 0.85rem;
      }
    </style>
  </head>

  <body>
    <div
      class="container d-flex justify-content-center align-items-center min-vh-100">
      <div class="register-container w-100 shadow-lg">
        <!-- Close Button -->
        <a href="/" class="close-btn" aria-label="Close">&times;</a>

        <!-- Header (Smaller text & spacing) -->
        <h2
          class="text-center fw-bold mb-3 text-uppercase"
          style="letter-spacing: 0.5px; font-size: 1.25rem">
          Sign Up To Start
        </h2>

        <!-- Form with smaller bottom margins (mb-2/mb-3) -->
        <form action="/register" method="POST" enctype="multipart/form-data">
          <div class="mb-3">
            <input
              type="text"
              name="name"
              class="form-control form-control-custom"
              placeholder="What's your name?"
              required />
          </div>

          <div class="mb-3">
            <input
              type="email"
              name="email"
              class="form-control form-control-custom"
              placeholder="What's your e-mail?"
              required />
          </div>

          <div class="mb-3">
            <input
              type="text"
              name="rollNo"
              class="form-control form-control-custom"
              placeholder="Your roll number?"
              required />
          </div>

          <div class="mb-4">
            <input
              type="password"
              name="password"
              class="form-control form-control-custom"
              placeholder="Your password?"
              required />
          </div>
          <div class="mb-4">
            <label class="form-label fw-bold"> Student Profile Photo </label>

            <input
              type="file"
              name="photo"
              class="form-control"
              accept="image/*"
              required />

            <small class="text-muted">
              Upload a passport-size photo (JPG, PNG, WEBP)
            </small>
          </div>

          <button type="submit" class="btn btn-custom-purple w-100 mb-3">
            Register
          </button>

          <div class="d-flex justify-content-center pt-1 footer-text">
            <span class="text-muted me-1">Already have an account?</span>
            <a href="/student-login" class="footer-link">Login</a>
          </div>
        </form>
      </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
