<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GNITC Faculty Portal | <%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    
<style>
        /* 1. Define the Global Brand Colors */
        :root {
            --gnitc-brand: #6474DB;
            --gnitc-brand-hover: #5363c5; /* Slightly darker for hover states */
        }

        body {
            background-color: #f4f6f9; 
        }

        /* 2. Sidebar Styling */
        .sidebar {
            min-height: 100vh;
            background-color: #212529; 
            color: white;
        }
        .sidebar a {
            color: #adb5bd;
            text-decoration: none;
            padding: 12px 20px;
            display: block;
            border-radius: 5px;
            margin-bottom: 5px;
            transition: all 0.3s;
        }
        
        /* Apply brand color to active sidebar links */
        .sidebar a:hover, .sidebar a.active {
            background-color: var(--gnitc-brand);
            color: white;
        }

        .main-content {
            padding: 30px;
        }
        .navbar-brand {
            font-weight: bold;
            letter-spacing: 1px;
        }

        /* 3. Force Bootstrap to use #6474DB for all 'primary' elements */
        .text-primary { color: var(--gnitc-brand) !important; }
        .bg-primary { background-color: var(--gnitc-brand) !important; }
        .border-primary { border-color: var(--gnitc-brand) !important; }
        
        .btn-primary { 
            background-color: var(--gnitc-brand); 
            border-color: var(--gnitc-brand); 
        }
        .btn-primary:hover, .btn-primary:focus, .btn-primary:active { 
            background-color: var(--gnitc-brand-hover) !important; 
            border-color: var(--gnitc-brand-hover) !important; 
        }
        
        .badge.bg-primary { background-color: var(--gnitc-brand) !important; }
    </style>
</head>
<body>

<div class="container-fluid">
    <div class="row">
        
        <nav class="col-md-3 col-lg-2 d-md-flex flex-column sidebar py-4">
            
            <div>
                <div class="text-center mb-4">
                    <i class="bi bi-building fs-1 text-primary"></i>
                    <h4 class="mt-2 navbar-brand text-white">GNITC</h4>
                    <p class="text-muted small">Faculty Portal</p>
                </div>
                
                <hr class="border-secondary">

                <div class="nav flex-column">
                    <a href="/faculty/overview" class="<%= body === 'overview' ? 'active' : '' %>">
                        <i class="bi bi-grid me-2"></i> Dashboard
                    </a>
                    <a href="/faculty/students" class="<%= body === 'directory' ? 'active' : '' %>">
                        <i class="bi bi-people me-2"></i> Student Directory
                    </a>
                    <a href="#" class="text-muted">
                        <i class="bi bi-clipboard-check me-2"></i> Attendance
                    </a>
                    <a href="#" class="text-muted">
                        <i class="bi bi-wallet2 me-2"></i> Fee Management
                    </a>
                </div>
            </div>

            <div class="mt-auto w-100">
                <hr class="border-secondary">
                <a href="/faculty/login" class="text-danger" style="transition: none;">
                    <i class="bi bi-box-arrow-right me-2"></i> Logout
                </a>
            </div>
            
        </nav>

        <main class="col-md-9 ms-sm-auto col-lg-10 main-content">
            
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
                <h1 class="h2"><%= title %></h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <span class="badge bg-primary fs-6">Admin Access</span>
                </div>
            </div>

            <%- include(`${body}`) %> 

        </main>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>