<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Master Student List</h6>
        <div class="input-group" style="width: 250px;">
            <input type="text" id="studentSearch" class="form-control form-control-sm"
                placeholder="Search by Roll No or Name...">
            <button class="btn btn-sm btn-outline-secondary" type="button"><i class="bi bi-search"></i></button>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="ps-4">Roll Number</th>
                        <th scope="col">Student Name</th>
                        <th scope="col">Attendance</th>
                        <th scope="col">Fees Due</th>
                        <th scope="col" class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (students && students.length > 0) { %>
                        <% students.forEach(student => { %>
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-secondary">
                                        <%= student.rollNo %>
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">
                                        <%= student.studentAccountId ? student.studentAccountId.name : 'Data Missing' %>
                                    </div>
                                    <small class="text-muted">
                                        <%= student.studentAccountId ? student.studentAccountId.email : 'N/A' %>
                                    </small>
                                </td>
                                
                                <td>
                                    <button type="button" class="btn btn-sm btn-light border update-attendance-btn"
                                        data-bs-toggle="modal" data-bs-target="#attendanceModal"
                                        data-rollno="<%= student.rollNo %>"
                                        data-total="<%= student.dynamicTotalClasses %>"
                                        data-attended="<%= student.dynamicClassesAttended %>"
                                        title="Update Attendance">
                                        <i class="bi bi-calendar-check text-primary"></i>
                                    </button>
                                    <small class="text-muted">
                                        <%= student.dynamicClassesAttended %> / <%= student.dynamicTotalClasses %> Classes
                                    </small>
                                </td>

                                <td>
                                    <button type="button" class="btn btn-sm btn-light border update-fee-btn"
                                        data-bs-toggle="modal" data-bs-target="#feeModal"
                                        data-rollno="<%= student.rollNo %>" data-due="<%= student.fees.dueAmount %>"
                                        title="Manage Fees">

                                        <i class="bi bi-wallet2 text-success"></i>
                                    </button>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group shadow-sm">
                                        <button type="button" class="btn btn-sm btn-light border"
                                            title="Update Attendance">
                                            <i class="bi bi-calendar-check text-primary"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-light border" title="Manage Fees">
                                            <i class="bi bi-wallet2 text-success"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No student records found in the database.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="attendanceModal" tabindex="-1" aria-labelledby="attendanceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title" id="attendanceModalLabel">
                    <i class="bi bi-calendar-check text-primary me-2"></i>Update Attendance
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/faculty/attendance/update" method="POST">
                <div class="modal-body p-4">
                    <input type="hidden" name="rollNo" id="modalRollNo">

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase">Student Roll Number</label>
                        <input type="text" class="form-control bg-light" id="displayRollNo" disabled>
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">Total Classes</label>
                            <input type="number" class="form-control" name="totalClasses" id="modalTotal" required
                                min="0">
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Classes Attended</label>
                            <input type="number" class="form-control" name="classesAttended" id="modalAttended" required
                                min="0">
                        </div>
                    </div>

                    <div class="alert alert-info py-2 mt-2 mb-0 border-0 bg-opacity-10 d-flex align-items-center">
                        <i class="bi bi-info-circle me-2"></i>
                        <small>Percentage will be calculated automatically.</small>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="feeModal" tabindex="-1" aria-labelledby="feeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title" id="feeModalLabel">
                    <i class="bi bi-wallet2 text-success me-2"></i>Process Fee Payment
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/faculty/fees/pay" method="POST">
                <div class="modal-body p-4">
                    <input type="hidden" name="rollNo" id="feeModalRollNo">

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase">Student Roll Number</label>
                        <input type="text" class="form-control bg-light" id="feeDisplayRollNo" disabled>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase">Current Due Amount (₹)</label>
                        <input type="text" class="form-control bg-light text-danger fw-bold" id="feeDisplayDue"
                            disabled>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Payment Amount (₹)</label>
                        <input type="number" class="form-control" name="paymentAmount" required min="1"
                            placeholder="Enter amount being paid...">
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Record Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.getElementById('studentSearch').addEventListener('keyup', function () {
        let searchQuery = this.value.toLowerCase();
        let tableRows = document.querySelectorAll('tbody tr');

        tableRows.forEach(row => {
            if (row.cells.length > 1) {
                let rollNo = row.cells[0].textContent.toLowerCase();
                let nameText = row.cells[1].textContent.toLowerCase();

                if (rollNo.includes(searchQuery) || nameText.includes(searchQuery)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            }
        });
    });

    const attendanceBtns = document.querySelectorAll('.update-attendance-btn');
    attendanceBtns.forEach(btn => {
        btn.addEventListener('click', function () {
            const rollNo = this.getAttribute('data-rollno');
            const total = this.getAttribute('data-total');
            const attended = this.getAttribute('data-attended');

            document.getElementById('modalRollNo').value = rollNo;
            document.getElementById('displayRollNo').value = rollNo;
            document.getElementById('modalTotal').value = total;
            document.getElementById('modalAttended').value = attended;
        });
    });

    const feeBtns = document.querySelectorAll('.update-fee-btn');
    feeBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            const rollNo = this.getAttribute('data-rollno');
            const dueAmount = this.getAttribute('data-due');
            
            document.getElementById('feeModalRollNo').value = rollNo;
            document.getElementById('feeDisplayRollNo').value = rollNo;
            document.getElementById('feeDisplayDue').value = dueAmount;
        });
    });
</script>