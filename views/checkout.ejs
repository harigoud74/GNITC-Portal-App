<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Secure Checkout - GNITC</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      body {
        background-color: #f0f2f5;
      }
      .gateway-card {
        border-top: 6px solid #4f46e5;
      }
      .payment-option {
        cursor: pointer;
        transition: 0.2s;
      }
      .payment-option:hover {
        background-color: #f8f9fa;
        border-color: #4f46e5 !important;
      }

      /* Make the editable input look nice when clicked */
      .editable-amount {
        border-bottom: 2px dashed #adb5bd !important;
        border-radius: 0;
        transition: border-color 0.2s;
      }
      .editable-amount:focus {
        box-shadow: none;
        border-bottom: 2px solid #4f46e5 !important;
        background: transparent !important;
      }
    </style>
  </head>
  <body class="d-flex align-items-center justify-content-center min-vh-100">
    <div class="container" style="max-width: 500px">
      <div class="text-center mb-4">
        <h4 class="fw-bold text-dark">
          <i class="bi bi-shield-lock-fill text-success me-2"></i>Secure Payment
          Gateway
        </h4>
        <p class="text-muted small">
          Encrypted & processing via simulated gateway
        </p>
      </div>

      <div
        class="card border-0 shadow-lg rounded-4 gateway-card overflow-hidden">
        <div class="bg-light p-4 border-bottom">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted fw-bold small text-uppercase"
              >Paying to</span
            >
            <span class="badge bg-primary rounded-pill">GNITC Admin</span>
          </div>
          <h5 class="fw-bold mb-0 text-dark">Tuition Fee Clearance</h5>
          <p class="text-muted small mb-0">
            <%= student.name %> (<%= student.rollNo %>)
          </p>
        </div>

        <div class="p-4 p-md-5">
          <form action="/process-payment/<%= student.rollNo %>" method="POST">
            <div class="mb-4 text-center">
              <label class="text-muted small fw-bold text-uppercase mb-2"
                >Amount to Pay</label
              >

              <div
                class="input-group input-group-lg justify-content-center align-items-end mb-1">
                <span
                  class="input-group-text bg-transparent border-0 fs-3 fw-bold text-dark px-1 mb-1"
                  >₹</span
                >

                <input
                  type="number"
                  name="paymentAmount"
                  class="form-control editable-amount border-0 border-bottom fs-1 fw-bold text-dark text-center p-0 mx-1"
                  style="max-width: 180px; background: transparent"
                  value="<%= profile.fees.dueAmount %>"
                  min="1"
                  max="<%= profile.fees.dueAmount %>"
                  required />
              </div>

              <small class="text-primary fw-bold"
                ><i class="bi bi-pencil-square me-1"></i>Tap number to enter a
                partial amount</small
              >
            </div>

            <h6 class="fw-bold text-secondary mb-3 small text-uppercase">
              Select Payment Method
            </h6>

            <div
              class="border rounded-3 p-3 mb-3 payment-option border-primary bg-primary bg-opacity-10">
              <div class="form-check d-flex align-items-center m-0">
                <input
                  class="form-check-input fs-5 me-3"
                  type="radio"
                  name="method"
                  id="upi"
                  checked />
                <label class="form-check-label fw-bold flex-grow-1" for="upi">
                  Pay via UPI <br />
                  <small class="text-muted fw-normal"
                    >Google Pay, PhonePe, Paytm</small
                  >
                </label>
                <i class="bi bi-qr-code-scan fs-3 text-primary"></i>
              </div>
            </div>

            <div class="border rounded-3 p-3 mb-4 payment-option">
              <div class="form-check d-flex align-items-center m-0">
                <input
                  class="form-check-input fs-5 me-3"
                  type="radio"
                  name="method"
                  id="card"
                  disabled />
                <label
                  class="form-check-label fw-bold text-muted flex-grow-1"
                  for="card">
                  Credit / Debit Card <br />
                  <small class="fw-normal"
                    >Currently unavailable in simulation</small
                  >
                </label>
                <i class="bi bi-credit-card fs-3 text-muted"></i>
              </div>
            </div>

            <button
              type="submit"
              class="btn btn-success btn-lg w-100 fw-bold rounded-pill shadow-sm">
              Confirm Payment <i class="bi bi-arrow-right ms-2"></i>
            </button>

            <div class="text-center mt-3">
              <a
                href="javascript:history.back()"
                class="text-danger small text-decoration-none fw-bold"
                >Cancel Transaction</a
              >
            </div>
          </form>
        </div>
      </div>
    </div>
  </body>
</html>
