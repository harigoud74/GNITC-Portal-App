<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Faculty Dashboard - GNITC</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
  <style>
    body { background-color: #f8f9fa; }
    /* Slightly darker hover state for these larger rows */
    .table-hover tbody tr:hover { background-color: #e9ecef; }
  </style>
</head>
<body>
  
  <nav class="navbar navbar-dark bg-dark shadow-sm mb-5">
    <div class="container">
      <a class="navbar-brand fw-bold tracking-wide" href="#">
        <i class="bi bi-shield-lock-fill text-warning me-2"></i>GNITC Admin Portal
      </a>
      <a href="/student-login" class="btn btn-outline-light btn-sm">Secure Logout</a>
    </div>
  </nav>

  <div class="container pb-5 mt-4">
    
    <div class="d-flex justify-content-between align-items-end mb-4">
      <div>
        <h2 class="fw-bold text-dark mb-1">Student Records</h2>
        <p class="text-muted mb-0">Manage attendance and fee dues in real-time.</p>
      </div>
      <div class="text-end">
        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-2 fs-6 rounded-pill">
          <i class="bi bi-people-fill me-1"></i> Total Enrolled: <%= auths.length %>
        </span>
      </div>
    </div>

    <div class="row mb-4">
      <div class="col-md-6 col-lg-4">
        <div class="input-group shadow-sm rounded-3 overflow-hidden">
          <span class="input-group-text bg-white border-end-0 pe-1"><i class="bi bi-search text-muted"></i></span>
          <input type="text" id="searchInput" class="form-control border-start-0 border-end-0 py-2 shadow-none" placeholder="Search by name or roll no...">
        </div>
      </div>
    </div>

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="min-width: 900px;">
          <thead class="bg-light">
            <tr>
              <th class="px-4 py-3 text-secondary text-uppercase small fw-bold" style="width: 25%;">Student Details</th>
              <th class="py-3 text-secondary text-uppercase small fw-bold" style="width: 35%;">Attendance Tracker</th>
              <th class="px-4 py-3 text-secondary text-uppercase small fw-bold" style="width: 40%;">Fee Management</th>
            </tr>
          </thead>
          <tbody>
            
            <% auths.forEach(function(student) { 
                const profile = profiles.find(p => p.rollNo === student.rollNo);
                if(profile) { 
            %>
              <tr class="border-bottom">
                
                <td class="px-4 py-4 align-top">
                  <div class="d-flex align-items-center mt-2">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex justify-content-center align-items-center me-3 shadow-sm" style="width: 55px; height: 55px; font-size: 1.5rem; font-weight: bold;">
                      <%= student.name.charAt(0) %>
                    </div>
                    <div>
                      <h5 class="mb-1 fw-bold text-dark"><%= student.name %></h5>
                      <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill tracking-wide"><%= student.rollNo %></span>
                    </div>
                  </div>
                </td>
                
                <td class="py-4 align-top pe-3">
                  <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                    <div class="card-body p-3">
                      <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-secondary text-uppercase mb-0 small">
                          <i class="bi bi-calendar-check text-primary me-2"></i>Attendance
                        </h6>
                        <span class="badge bg-light text-dark border px-2 py-1 rounded-3">
                          Current: <%= profile.attendance.percentage %>%
                        </span>
                      </div>

                      <div class="progress mb-3" style="height: 8px; border-radius: 10px;">
                        <div class="progress-bar <%= profile.attendance.percentage >= 75 ? 'bg-success' : (profile.attendance.percentage >= 60 ? 'bg-warning' : 'bg-danger') %>" 
     role="progressbar"
                      </div>
                      </div>

                      <form action="/faculty/update-attendance/<%= student.rollNo %>" method="POST" class="mt-auto m-0">
                        <div class="input-group input-group-sm">
                          <input type="number" name="attendance" class="form-control bg-light border-end-0 fw-bold" value="<%= profile.attendance.percentage %>" min="0" max="100" required>
                          <span class="input-group-text bg-light text-muted border-start-0">%</span>
                          <button type="submit" class="btn btn-dark px-3 fw-bold">Update</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </td>

                <td class="px-4 py-4 align-top">
                  <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                    <div class="card-body p-3 d-flex flex-column">
                      
                      <% if (profile.fees.dueAmount === 0) { %>
                        <div class="text-center my-auto py-2">
                          <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 40px; height: 40px; font-size: 1.2rem;">
                            <i class="bi bi-check2-circle"></i>
                          </div>
                          <h6 class="fw-bold text-success mb-0">Fully Paid</h6>
                          <small class="text-muted" style="font-size: 11px;">No pending dues.</small>
                        </div>
                        
                      <% } else { %>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                          <h6 class="fw-bold text-secondary text-uppercase mb-0 small">
                            <i class="bi bi-wallet2 text-danger me-2"></i>Total Due
                          </h6>
                          <h5 class="text-danger fw-bold mb-0">₹<%= profile.fees.dueAmount.toLocaleString('en-IN') %></h5>
                        </div>

                        <form action="/faculty/update-fees/<%= student.rollNo %>" method="POST" class="mt-auto m-0">
                          <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-muted border-end-0">₹</span>
                            <input type="number" name="payment" class="form-control bg-light border-start-0 fw-bold" placeholder="Payment amount..." min="1" max="<%= profile.fees.dueAmount %>" required>
                            <button type="submit" class="btn btn-primary px-3 fw-bold">Process</button>
                          </div>
                        </form>
                      <% } %>

                    </div>
                  </div>
                </td>

              </tr>
            <% } 
            }); %>

          </tbody>
        </table>
      </div>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  
  <script>
    document.getElementById('searchInput').addEventListener('keyup', function() {
      let filter = this.value.toLowerCase();
      let rows = document.querySelectorAll('tbody tr');

      rows.forEach(row => {
        let text = row.textContent.toLowerCase();
        row.style.display = text.includes(filter) ? '' : 'none';
      });
    });
  </script>
</body>
</html>