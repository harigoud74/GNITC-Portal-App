<tbody>
                            <% students.forEach(profile => { %>
                                <% const authData = profile.studentAccountId; %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-3 fw-bold">
                                                <%= authData ? authData.name.charAt(0) : '?' %>
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-bold text-dark"><%= authData ? authData.name : 'Unknown' %></h6>
                                                <small class="text-muted"><%= profile.rollNo %></small>
                                            </div>
                                        </div>
                                    </td>
                                    
                                    <td class="align-middle">
                                        <% if (profile.fees.dueAmount === 0) { %>
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2">Cleared</span>
                                        <% } else { %>
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2">
                                                ₹<%= profile.fees.dueAmount.toLocaleString('en-IN') %> Due
                                            </span>
                                        <% } %>
                                    </td>
                                    
                                    <td class="align-middle">
                                        <% if (profile.digitalId && profile.digitalId.isValid) { %>
                                            <span class="badge bg-success px-3 py-2"><i class="bi bi-check-circle me-1"></i> Active</span>
                                        <% } else { %>
                                            <span class="badge bg-secondary px-3 py-2"><i class="bi bi-lock-fill me-1"></i> Locked</span>
                                        <% } %>
                                    </td>
                                    
                                    <td class="align-middle text-end">
                                        <form action="/admin/toggle-id/<%= profile.rollNo %>" method="POST" class="d-inline">
                                            <% if (profile.digitalId && profile.digitalId.isValid) { %>
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold shadow-sm">
                                                    Revoke ID
                                                </button>
                                            <% } else { %>
                                                <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold shadow-sm">
                                                    Approve ID
                                                </button>
                                            <% } %>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>