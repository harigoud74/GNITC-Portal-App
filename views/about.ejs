  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: "Poppins", sans-serif;

      background: #050816;

      overflow-x: hidden;

      color: white;
    }

    /* ===========================
      Aurora Background
=========================== */

    body::before {
      content: "";

      position: fixed;

      width: 700px;
      height: 700px;

      background: #2563eb;

      top: -250px;
      left: -250px;

      filter: blur(180px);

      opacity: 0.45;

      animation: blob1 12s infinite alternate;

      z-index: -5;
    }

    body::after {
      content: "";

      position: fixed;

      width: 600px;
      height: 600px;

      background: #7c3aed;

      bottom: -250px;
      right: -250px;

      filter: blur(180px);

      opacity: 0.45;

      animation: blob2 12s infinite alternate;

      z-index: -5;
    }

    @keyframes blob1 {
      100% {
        transform: translate(250px, 180px) scale(1.4);
      }
    }

    @keyframes blob2 {
      100% {
        transform: translate(-220px, -120px) scale(1.5);
      }
    }

    /* ===========================
Floating Circles
=========================== */

    .circle {
      position: absolute;

      border-radius: 50%;

      filter: blur(60px);

      opacity: 0.25;

      animation: float 8s ease-in-out infinite;
    }

    .c1 {
      width: 250px;
      height: 250px;

      background: #2563eb;

      top: 10%;

      left: 8%;
    }

    .c2 {
      width: 200px;
      height: 200px;

      background: #9333ea;

      bottom: 12%;

      right: 10%;

      animation-delay: 2s;
    }

    .c3 {
      width: 180px;
      height: 180px;

      background: #06b6d4;

      top: 50%;

      right: 30%;

      animation-delay: 4s;
    }

    @keyframes float {
      50% {
        transform: translateY(-40px) translateX(25px);
      }
    }

    /* ===========================
Navbar
=========================== */

    nav {
      background: rgba(255, 255, 255, 0.08);

      backdrop-filter: blur(20px);

      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .navbar-brand {
      font-size: 30px;

      font-weight: 800;

      letter-spacing: 2px;

      color: white !important;
    }

    .nav-link {
      color: white !important;

      margin-left: 25px;

      font-weight: 500;

      transition: 0.3s;
    }

    .nav-link:hover {
      color: #60a5fa !important;
    }

    /* ===========================
Hero
=========================== */

    .hero {
      min-height: 100vh;

      display: flex;

      align-items: center;

      justify-content: center;

      text-align: center;

      position: relative;
    }

    .hero h1 {
      font-size: 6rem;

      font-weight: 900;

      line-height: 1.1;

      background: linear-gradient(90deg, #ffffff, #60a5fa, #c084fc);

      -webkit-background-clip: text;

      -webkit-text-fill-color: transparent;
    }

    .hero p {
      font-size: 20px;

      color: #d1d5db;

      max-width: 850px;

      margin: auto;

      margin-top: 25px;

      line-height: 2;
    }

    /* ===========================
Buttons
=========================== */

    .btn-primary-custom {
      padding: 18px 45px;

      border: none;

      border-radius: 60px;

      background: linear-gradient(90deg, #2563eb, #7c3aed);

      font-weight: 600;

      font-size: 17px;

      color: white;

      transition: 0.4s;
    }

    .btn-primary-custom:hover {
      transform: translateY(-8px);

      box-shadow: 0 20px 45px rgba(37, 99, 235, 0.5);
    }

    .btn-secondary-custom {
      padding: 18px 45px;

      border-radius: 60px;

      border: 1px solid rgba(255, 255, 255, 0.15);

      background: rgba(255, 255, 255, 0.05);

      color: white;

      backdrop-filter: blur(20px);

      font-weight: 600;

      transition: 0.4s;
    }

    .btn-secondary-custom:hover {
      background: white;

      color: #111827;

      transform: translateY(-8px);
    }

    /* ===========================
Stats
=========================== */

    .stats {
      margin-top: 90px;
    }

    .stat-card {
      background: rgba(255, 255, 255, 0.08);

      backdrop-filter: blur(20px);

      border-radius: 25px;

      padding: 35px;

      border: 1px solid rgba(255, 255, 255, 0.08);

      transition: 0.4s;

      height: 100%;
    }

    .stat-card:hover {
      transform: translateY(-10px);
    }

    .stat-card h2 {
      font-size: 60px;

      font-weight: 900;

      background: linear-gradient(90deg, #60a5fa, #c084fc);

      -webkit-background-clip: text;

      -webkit-text-fill-color: transparent;
    }

    .stat-card p {
      color: #cbd5e1;

      margin-top: 10px;
    }

    /* ===========================
Scroll
=========================== */

    .scroll {
      position: absolute;

      bottom: 30px;

      left: 50%;

      transform: translateX(-50%);

      font-size: 35px;

      animation: bounce 2s infinite;
    }

    @keyframes bounce {
      50% {
        transform: translate(-50%, 15px);
      }
    }

    /* ===========================
Sections
=========================== */

    section {
      padding: 120px 0;
    }

    .glass {
      background: rgba(255, 255, 255, 0.08);

      border: 1px solid rgba(255, 255, 255, 0.08);

      backdrop-filter: blur(25px);

      border-radius: 30px;

      padding: 70px;
    }

    .section-title {
      font-size: 55px;

      font-weight: 800;

      margin-bottom: 30px;
    }

    .section-text {
      font-size: 18px;

      line-height: 2;

      color: #d1d5db;
    }

    .big-icon {
      font-size: 220px;

      background: linear-gradient(180deg, #60a5fa, #7c3aed);

      -webkit-background-clip: text;

      -webkit-text-fill-color: transparent;
    }
  </style>
</head>

