<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>All Students</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  </head>
  
  <body class="bg-dark text-light p-4"> 
    <div class="container">
      <h2 class="mb-4">Registered Students</h2>

      <div class="row">
        
        <% for(let student of students) { %>
          
          <div class="col-md-4 col-sm-6 mb-4">
            <div class="card bg-black border-secondary text-white h-100 shadow">
              <div class="card-body">
                
                <h5 class="card-title text-primary"><%= student.name %></h5>
                <h6 class="card-subtitle mb-3 text-muted">Roll No: <%= student.rollNo %></h6>
                
                <p class="card-text">
                  <small>Email: <%= student.email %></small>
                </p>
                
                <a href="#" class="btn btn-outline-primary btn-sm">View Profile</a>
              </div>
            </div>
          </div>

        <% } %>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>