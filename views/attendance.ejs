<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Attendance Details</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/profile.css" />
  </head>
  <body class="bg-light">
    <div class="container mt-4 max-w-md mx-auto" style="max-width: 480px">
      <a
        href="javascript:history.back()"
        class="text-decoration-none text-secondary mb-4 d-inline-block">
        <i class="bi bi-arrow-left fs-4"></i> Back to Dashboard
      </a>

      <h2 class="fw-bold text-primary mb-4">Attendance Details</h2>

      <div class="dash-card shadow-sm p-4 text-center">
        <div
          class="icon-circle bg-light-success mx-auto mb-3"
          style="width: 80px; height: 80px; font-size: 2.5rem">
          <i class="bi bi-calendar-check"></i>
        </div>

        <h1 class="display-4 fw-bold mb-0 text-success">
          <%= profile.attendance.percentage %>%
        </h1>
        <p class="text-muted mt-2">Overall Attendance</p>

        <hr class="my-4" />

        <div class="d-flex justify-content-between text-start">
          <div>
            <h6 class="text-muted mb-1">Total Classes</h6>
            <h4 class="fw-bold"><%= profile.attendance.totalClasses %></h4>
          </div>
          <div>
            <h6 class="text-muted mb-1">Attended</h6>
            <h4 class="fw-bold"><%= profile.attendance.classesAttended %></h4>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
