<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %> - GNITC Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      body { background-color: #f8f9fa; }
    </style>
  </head>
  <body>
    
    <nav class="navbar navbar-light bg-white shadow-sm mb-5">
      <div class="container">
        <a class="navbar-brand fw-bold text-primary" href="/dashboard">
          <i class="bi bi-mortarboard-fill me-2"></i>GNITC Portal
        </a>
        <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
          <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
      </div>
    </nav>

    <div class="container pb-5" style="max-width: 800px;">
      
      <div class="text-center mb-5">
        <div class="bg-<%= color %> bg-opacity-10 text-<%= color %> rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; font-size: 2.5rem;">
          <i class="bi <%= icon %>"></i>
        </div>
        <h1 class="fw-bold text-dark"><%= pageTitle %></h1>
        <p class="text-muted fs-5">Track your campus engagement.</p>
      </div>

      <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <% if (activities.length === 0) { %>
          <div class="p-5 text-center">
            <i class="bi bi-emoji-frown text-muted" style="font-size: 3rem;"></i>
            <h5 class="mt-3 text-secondary">No <%= pageTitle.toLowerCase() %> found.</h5>
            <p class="text-muted mb-0">It looks like you haven't registered for any yet.</p>
          </div>
        <% } else { %>
          <ul class="list-group list-group-flush">
            <% activities.forEach(function(activity) { %>
              <li class="list-group-item p-4 d-flex align-items-center">
                <div class="bg-light rounded-3 p-3 me-3 text-center border">
                  <span class="d-block fw-bold fs-5"><%= activity.joinedAt.getDate() %></span>
                  <span class="d-block small text-muted text-uppercase fw-bold"><%= activity.joinedAt.toLocaleString('default', { month: 'short' }) %></span>
                </div>
                <div>
                  <h5 class="fw-bold mb-1"><%= activity.activityName %></h5>
                  <span class="badge bg-<%= color %> bg-opacity-10 text-<%= color %> border border-<%= color %> rounded-pill">
                    <%= activity.type %>
                  </span>
                </div>
              </li>
            <% }); %>
          </ul>
        <% } %>
      </div>

    </div>

  </body>
</html>