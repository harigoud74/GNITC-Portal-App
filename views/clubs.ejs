<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Campus Clubs - GNITC</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      body {
        background-color: #f4f6f8;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      }
      .hover-lift {
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }
      .hover-lift:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
      }
      .bg-gradient-warning {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: white;
      }
    </style>
  </head>
  <body>
    <div class="container mt-4 mt-md-5 pb-5">
      <a
        href="javascript:history.back()"
        class="btn btn-white bg-white shadow-sm rounded-pill px-4 py-2 fw-bold text-dark mb-4 hover-lift border-0">
        <i class="bi bi-arrow-left me-2 text-primary"></i> Back to Dashboard
      </a>

      <div
        class="bg-gradient-warning rounded-4 p-4 p-md-5 mb-5 shadow position-relative overflow-hidden">
        <div class="position-relative z-1">
          <span
            class="badge bg-white text-warning px-3 py-2 rounded-pill shadow-sm fw-bold mb-3">
            <i class="bi bi-stars me-1"></i> Student Life
          </span>
          <h1 class="fw-bold mb-2">Campus Clubs & Societies</h1>
          <p class="mb-0 fs-5 opacity-75 max-w-75">
            Discover communities, join events, and build your network at GNITC.
          </p>
        </div>
        <i
          class="bi bi-people-fill position-absolute text-white"
          style="font-size: 14rem; right: 10px; top: -20px; opacity: 0.15"></i>
      </div>

      <div class="d-flex justify-content-between align-items-end mb-4">
        <h4 class="fw-bold text-dark mb-0">Active Directory</h4>
        <div class="input-group" style="max-width: 250px">
          <input
            type="text"
            class="form-control rounded-start-pill border-end-0 shadow-sm"
            placeholder="Search clubs..." />
          <button
            class="btn btn-white bg-white border border-start-0 rounded-end-pill shadow-sm text-muted">
            <i class="bi bi-search"></i>
          </button>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-md-6 col-lg-4">
          <div
            class="card border-0 shadow-sm rounded-4 h-100 hover-lift overflow-hidden">
            <div class="bg-dark text-white p-4 text-center">
              <i class="bi bi-code-slash display-4 mb-2"></i>
              <h5 class="fw-bold mb-0">Coding Ninjas</h5>
            </div>
            <div class="card-body p-4">
              <p class="text-muted small mb-3">
                For passionate developers looking to build real-world software
                and conquer hackathons.
              </p>
              <div class="d-flex justify-content-between align-items-center">
                <span class="badge bg-primary bg-opacity-10 text-primary"
                  >Tech</span
                >
                <button
                  class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold">
                  Join Club
                </button>
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-6 col-lg-4">
          <div
            class="card border-0 shadow-sm rounded-4 h-100 hover-lift overflow-hidden">
            <div class="bg-primary text-white p-4 text-center">
              <i class="bi bi-cpu display-4 mb-2"></i>
              <h5 class="fw-bold mb-0">Robotics & AI</h5>
            </div>
            <div class="card-body p-4">
              <p class="text-muted small mb-3">
                Explore the intersection of hardware and machine learning.
                Hands-on Arduino and Raspberry Pi.
              </p>
              <div class="d-flex justify-content-between align-items-center">
                <span class="badge bg-primary bg-opacity-10 text-primary"
                  >Hardware</span
                >
                <button
                  class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold">
                  Join Club
                </button>
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-6 col-lg-4">
          <div
            class="card border-0 shadow-sm rounded-4 h-100 hover-lift overflow-hidden">
            <div class="bg-danger text-white p-4 text-center">
              <i class="bi bi-music-note-beamed display-4 mb-2"></i>
              <h5 class="fw-bold mb-0">Rhythm & Arts</h5>
            </div>
            <div class="card-body p-4">
              <p class="text-muted small mb-3">
                The cultural heart of GNITC. Dance, music, theater, and fine
                arts societies.
              </p>
              <div class="d-flex justify-content-between align-items-center">
                <span class="badge bg-danger bg-opacity-10 text-danger"
                  >Cultural</span
                >
                <button
                  class="btn btn-success btn-sm rounded-pill px-3 fw-bold">
                  <i class="bi bi-check2 me-1"></i>Joined
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
