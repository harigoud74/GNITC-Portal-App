<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Financial Overview - GNITC</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background-color: #f4f6f8; font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif; }
        .card { transition: transform 0.2s; }
        .card:hover { transform: translateY(-5px); }
    </style>
</head>
<body>
    <div class="container mt-5 pb-5" style="max-width: 650px; margin: auto;">
        
        <a href="javascript:history.back()" class="btn btn-white bg-white shadow-sm rounded-pill px-4 py-2 fw-bold text-dark mb-4 border-0">
            <i class="bi bi-arrow-left me-2 text-primary"></i> Back to Dashboard
        </a>

        <% 
            let total = profile.fees?.totalFees || 100000;
            let paid = profile.fees?.amountPaid || 0;
            let due = profile.fees?.dueAmount !== undefined ? profile.fees.dueAmount : total;
            
            let progress = total > 0 ? Math.round((paid / total) * 100) : 0;
            let isFullyPaid = due <= 0;
        %>

        <div class="text-center mb-4">
            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                <i class="bi bi-wallet2 fs-2"></i>
            </div>
            <h2 class="fw-bold">Financial Overview</h2>
            <p class="text-muted">Academic Year 2025-2026</p>
        </div>

        <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
            
            <div class="p-4 text-center <%= isFullyPaid ? 'bg-success text-white' : 'bg-warning text-dark' %>">
                <p class="mb-1 text-uppercase fw-bold small opacity-75">Account Status</p>
                <h1 class="display-6 fw-bold mb-0">
                    <i class="bi <%= isFullyPaid ? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill' %> me-2"></i>
                    <%= isFullyPaid ? 'Fully Paid' : 'Pending Dues' %>
                </h1>
            </div>

            <div class="card-body p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                    <div>
                        <h4 class="fw-bold text-dark mb-0"><%= student.name %></h4>
                        <span class="text-muted"><%= student.rollNo %></span>
                    </div>
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">B.Tech CSE</span>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="fw-bold text-muted small text-uppercase">Payment Progress</span>
                        <span class="fw-bold <%= isFullyPaid ? 'text-success' : 'text-warning' %>"><%= progress %>% Cleared</span>
                    </div>
                    <div class="progress" style="height: 10px; border-radius: 10px;">
                        <div class="progress-bar <%= isFullyPaid ? 'bg-success' : 'bg-warning' %>" style="width: <%= progress %>%"></div>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-6">
                        <p class="text-muted small fw-bold mb-1"><i class="bi bi-receipt me-1"></i> Total Tuition Fee</p>
                        <h4 class="fw-bold text-dark mb-0">₹<%= total.toLocaleString('en-IN') %></h4>
                    </div>
                    <div class="col-6 text-end">
                        <p class="text-muted small fw-bold mb-1"><i class="bi bi-check2-circle me-1"></i> Total Amount Paid</p>
                        <h4 class="fw-bold text-success mb-0">₹<%= paid.toLocaleString('en-IN') %></h4>
                    </div>
                </div>

                <div class="bg-light rounded-3 p-3 text-center">
                    <% if (isFullyPaid) { %>
                        <span class="text-success fw-bold"><i class="bi bi-emoji-smile me-1"></i> You are all caught up for this semester!</span>
                    <% } else { %>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="text-start">
                                <span class="text-muted fw-bold d-block">Pending Amount</span>
                                <h3 class="text-dark fw-bold mb-0">₹<%= due.toLocaleString('en-IN') %></h3>
                            </div>
                            <a href="/checkout/<%= student.rollNo %>" class="btn btn-primary px-4 rounded-pill fw-bold shadow-sm hover-lift">Pay Now</a>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <h5 class="fw-bold text-dark mt-5 mb-3">Transaction History</h5>
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
            <div class="card-body p-0">
                <% if (profile.fees && profile.fees.transactions && profile.fees.transactions.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4 py-3 small text-muted text-uppercase fw-bold">Date</th>
                                    <th class="py-3 small text-muted text-uppercase fw-bold">Txn ID</th>
                                    <th class="py-3 small text-muted text-uppercase fw-bold">Method</th>
                                    <th class="text-end pe-4 py-3 small text-muted text-uppercase fw-bold">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% profile.fees.transactions.slice().reverse().forEach(txn => { %>
                                    <tr>
                                        <td class="ps-4">
                                            <span class="fw-bold text-dark"><%= new Date(txn.date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></span>
                                        </td>
                                        <td><span class="badge bg-light text-secondary border font-monospace"><%= txn.transactionId %></span></td>
                                        <td><small class="text-muted"><%= txn.paymentMethod %></small></td>
                                        <td class="text-end pe-4">
                                            <span class="fw-bold text-success">+ ₹<%= txn.amount.toLocaleString('en-IN') %></span>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-receipt fs-1 d-block mb-2 opacity-50"></i>
                        <p class="mb-0">No transactions recorded yet.</p>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="bg-primary bg-opacity-10 border border-primary border-opacity-25 rounded-4 p-4 d-flex align-items-center">
            <i class="bi bi-headset text-primary fs-2 me-3"></i>
            <div>
                <h6 class="fw-bold text-primary mb-1">Need help with payments?</h6>
                <p class="text-muted small mb-0">Contact the GNITC accounts department at <strong>accounts@gnitc.edu</strong></p>
            </div>
        </div>

    </div>
</body>
</html>