<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Campus Events - GNITC</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      body {
        background-color: #f4f6f8;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      }
      .hover-lift {
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }
      .hover-lift:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
      }
      /* Purple/Pink Gradient for Events */
      .bg-gradient-primary {
        background: linear-gradient(135deg, #8b5cf6 0%, #ec4899 100%);
        color: white;
      }
    </style>
  </head>
  <body>
    <div class="container mt-4 mt-md-5 pb-5">
      <!-- Back Navigation -->
      <a
        href="javascript:history.back()"
        class="btn btn-white bg-white shadow-sm rounded-pill px-4 py-2 fw-bold text-dark mb-4 hover-lift border-0">
        <i class="bi bi-arrow-left me-2 text-primary"></i> Back to Dashboard
      </a>

      <!-- Premium Header -->
      <div
        class="bg-gradient-primary rounded-4 p-4 p-md-5 mb-5 shadow position-relative overflow-hidden">
        <div class="position-relative z-1">
          <span
            class="badge bg-white text-primary px-3 py-2 rounded-pill shadow-sm fw-bold mb-3">
            <i class="bi bi-ticket-perforated me-1"></i> Campus Life
          </span>
          <h1 class="fw-bold mb-2">Upcoming Events</h1>
          <p class="mb-0 fs-5 opacity-75 max-w-75">
            Register for hackathons, guest lectures, and cultural fests.
          </p>
        </div>
        <!-- Decorative Background Icon -->
        <i
          class="bi bi-calendar2-event-fill position-absolute text-white"
          style="font-size: 14rem; right: 10px; top: -20px; opacity: 0.15"></i>
      </div>

      <!-- Filter/Tabs -->
      <div class="d-flex mb-4 gap-2 border-bottom pb-3">
        <button class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
          Upcoming
        </button>
        <button
          class="btn btn-white bg-white border rounded-pill px-4 fw-bold text-muted">
          Registered
        </button>
        <button
          class="btn btn-white bg-white border rounded-pill px-4 fw-bold text-muted">
          Past Events
        </button>
      </div>

      <!-- Events Grid -->
      <div class="row g-4">
        <!-- Event Card 1 -->
        <div class="col-lg-6">
          <div
            class="card border-0 shadow-sm rounded-4 hover-lift overflow-hidden h-100">
            <div class="row g-0 h-100">
              <div
                class="col-sm-4 bg-dark text-white d-flex flex-column justify-content-center align-items-center p-4">
                <h2 class="fw-bold mb-0">15</h2>
                <h5 class="text-uppercase mb-0 opacity-75">Oct</h5>
              </div>
              <div class="col-sm-8 p-4">
                <div
                  class="d-flex justify-content-between align-items-start mb-2">
                  <span class="badge bg-primary bg-opacity-10 text-primary"
                    >Technical</span
                  >
                  <i class="bi bi-share text-muted"></i>
                </div>
                <h5 class="fw-bold text-dark">National Level Hackathon 2026</h5>
                <p class="text-muted small mb-3">
                  <i class="bi bi-geo-alt me-1"></i> Main Auditorium, Block A
                </p>
                <button
                  class="btn btn-primary btn-sm rounded-pill px-4 fw-bold w-100">
                  Register Now
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Event Card 2 -->
        <div class="col-lg-6">
          <div
            class="card border-0 shadow-sm rounded-4 hover-lift overflow-hidden h-100">
            <div class="row g-0 h-100">
              <div
                class="col-sm-4 bg-danger text-white d-flex flex-column justify-content-center align-items-center p-4">
                <h2 class="fw-bold mb-0">22</h2>
                <h5 class="text-uppercase mb-0 opacity-75">Oct</h5>
              </div>
              <div class="col-sm-8 p-4">
                <div
                  class="d-flex justify-content-between align-items-start mb-2">
                  <span class="badge bg-danger bg-opacity-10 text-danger"
                    >Cultural</span
                  >
                  <i class="bi bi-share text-muted"></i>
                </div>
                <h5 class="fw-bold text-dark">Diwali Cultural Fest</h5>
                <p class="text-muted small mb-3">
                  <i class="bi bi-geo-alt me-1"></i> Open Air Theater (OAT)
                </p>
                <button
                  class="btn btn-outline-danger btn-sm rounded-pill px-4 fw-bold w-100">
                  View Details
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
