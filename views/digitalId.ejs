<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Digital Student ID | Guru Nanak Institutes Technical Campus</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet" />

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: "Segoe UI", sans-serif;
      }

      body {
        background: linear-gradient(135deg, #dbeafe, #eff6ff, #ffffff);

        min-height: 100vh;

        display: flex;

        justify-content: center;

        align-items: center;

        padding: 60px;
      }

      .id-card {
        width: 430px;

        background: white;

        border-radius: 28px;

        overflow: hidden;

        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.15);

        position: relative;
      }

      .card-header{
    background: linear-gradient(135deg,#1e3a8a,#2563eb);
    color:#fff;
    padding:30px 28px 110px;   /* Increased bottom padding */
    position:relative;
}
      .logo {
        display: flex;
        align-items: center;
        gap: 16px;
      }

      .logo img {
        width: 68px;
        height: 68px;
        padding: 6px;

        object-fit: contain;

        background: white;

        padding: 5px;

        border-radius: 12px;
      }

      .college {
        font-size: 20px;
        line-height: 1.25;
        font-weight: 700;
      }

      .subtitle {
        opacity: 0.85;

        font-size: 14px;

        margin-top: 5px;
      }

      .qr{
    position:absolute;
    right:25px;
    top:25px;

    width:75px;
    height:75px;

    background:white;

    border-radius:12px;

    display:flex;
    justify-content:center;
    align-items:center;

    padding:6px;

    box-shadow:0 4px 12px rgba(0,0,0,.15);
}

.qr img{
    width:100%;
    height:100%;
    object-fit:contain;
}

      .avatar {
        width: 130px;

        height: 130px;

        border-radius: 50%;

        background: linear-gradient(135deg, #2563eb, #4338ca);

        color: white;

        display: flex;

        justify-content: center;

        align-items: center;

        font-size: 58px;

        font-weight: 700;

        margin: -55px auto 15px;

        border: 6px solid white;

        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);

        position: relative;

        z-index: 10;
        margin-top: -48px;
        margin-bottom: 25px;
      }

      .name{
    margin-top:20px;
    text-align:center;
    font-size:34px;
    font-weight:800;
}

      .role {
        width: max-content;

        margin: 12px auto;

        padding: 6px 18px;

        background: #2563eb;

        color: white;

        border-radius: 50px;

        font-size: 13px;

        font-weight: 600;

        letter-spacing: 1px;
      }

      .card-body {
        padding: 30px;
      }

      .info {
        margin-top: 20px;
      }

      .row-info {
        display: flex;

        justify-content: space-between;

        padding: 12px 0;

        border-bottom: 1px solid #edf2f7;
      }

      .label {
        font-weight: 600;

        color: #555;
      }

      .value {
        font-weight: 700;

        color: #111827;
      }

      .footer {
        padding: 20px;

        background: #f8fafc;

        display: flex;

        justify-content: space-between;

        align-items: center;
      }

      .status {
        background: #22c55e;

        color: white;

        padding: 8px 18px;

        border-radius: 40px;

        font-size: 13px;

        font-weight: 700;
      }

      .security {
        font-size: 13px;

        color: #64748b;
      }

.avatar-img{
    width:120px;
    height:145px;

    border-radius:18px;

    object-fit:cover;
    object-position:center top;

    border:5px solid #fff;

    display:block;

    /* This brings the photo lower */
    margin:-70px auto 22px;

    position:relative;
    z-index:10;

    box-shadow:0 12px 24px rgba(0,0,0,.20);
}
.row-info{
    display:grid;
    grid-template-columns:40px 1fr auto;
    align-items:center;

    padding:16px 0;
    border-bottom:1px solid #edf2f7;
    column-gap:18px;
}

.row-info i{
    font-size:20px;
    color:#1e3a8a;
}

.label{
    font-size:18px;
    font-weight:500;
    color:#4b5563;
}

.value{
    font-size:18px;
    font-weight:700;
    color:#111827;
    text-align:right;
}
/* ===========================
   PDF / Print Styling
=========================== */
.no-print{
    text-align:center;
    margin-top:25px;
}

@media print {

    body{
        background:#ffffff !important;
        margin:0 !important;
        padding:0 !important;
    }

    .id-card{
        width:430px !important;
        margin:0 auto !important;
        box-shadow:none !important;
        border-radius:28px;
        border:1px solid #ddd;
    }

    .no-print{
        display:none !important;
    }
}
    </style>
  </head>

  <body>
    <div class="id-card">
      <div class="card-header">
        <div class="logo">
          <img src="/images/gnitc-logo.png" />

          <div>
            <div class="college">Guru Nanak Institutes Technical Campus</div>

            <div class="subtitle">Autonomous Institution • Hyderabad</div>
          </div>
        </div>

        <div class="qr">
    <img src="<%= qrCode %>" alt="QR Code">
</div>
      </div>
<% if (profile.personal.profileImage) { %>
    <img
        src="<%= profile.personal.profileImage %>"
        class="avatar-img"
        alt="Student Photo">
<% } else { %>
    <div class="avatar">
        <%= student.name.charAt(0).toUpperCase() %>
    </div>
<% } %>

      <div class="name"><%= student.name %></div>

      <div class="role">STUDENT B.Tech Computer Science Engineering</div>

      <div class="card-body">
        <div class="info">
          <div class="row-info">
    <i class="bi bi-person-vcard"></i>
    <span class="label">Roll Number</span>
    <span class="value"><%= student.rollNo %></span>
</div>

<div class="row-info">
    <i class="bi bi-building"></i>
    <span class="label">Department</span>
    <span class="value"><%= profile.academic.department %></span>
</div>

<div class="row-info">
    <i class="bi bi-mortarboard"></i>
    <span class="label">Program</span>
    <span class="value"><%= profile.academic.program %></span>
</div>

<div class="row-info">
    <i class="bi bi-journal-bookmark"></i>
    <span class="label">Semester</span>
    <span class="value"><%= profile.academic.semester %></span>
</div>

<div class="row-info">
    <i class="bi bi-people"></i>
    <span class="label">Section</span>
    <span class="value"><%= profile.academic.section %></span>
</div>
        
      </div>
      <div class="footer">
        <div class="status">
          ✔ VERIFIED Issued by Guru Nanak Institutes Technical Campus ID:
          GNITC-24WJ1A05B2
        </div>

        <div class="security">
          <i class="bi bi-shield-check-fill text-success"></i>

          Secure Digital ID
        </div>
      </div>
       <div class="text-center mt-4">

    <div class="no-print">
    <a
        href="/digital-id/pdf/<%= student.rollNo %>"
        class="btn btn-primary btn-lg">

        <i class="bi bi-download"></i>
        Download Digital ID

    </a>
</div>

</div>
    </div>
   
  </body>
</html>
